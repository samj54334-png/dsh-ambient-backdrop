{
  "name": "dsh-ambient-backdrop",
  "version": "1.2.1",
  "type": "module",
  "description": "Acrylic Harness backdrop: every surface turns translucent and frosted over a gradient or your own picture.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "backdrop",
    "acrylic",
    "wallpaper"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samj54334-png/dsh-ambient-backdrop.git"
  },
  "homepage": "https://github.com/samj54334-png/dsh-ambient-backdrop#readme",
  "bugs": {
    "url": "https://github.com/samj54334-png/dsh-ambient-backdrop/issues"
  }
}